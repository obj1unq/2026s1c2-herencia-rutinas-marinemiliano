import gimnasia.*
import personas.*
import clubes.*



describe "rutinas" {

//Punto 1: rutinas

	test "una actividad de intensidad de 1.2" {
		
		const remarEnElDelta = new Remo()
		const correrEnLaPlaya = new Running(intensidad = 1.2)
		
		const maratonBA = new Maraton(intensidad = 1.5)
		assert.equals(1.2, correrEnLaPlaya.intensidad())
		assert.equals(1.3, remarEnElDelta.intensidad())
		
	}


//Punto 2: personas
	

	test "calamardo persona sedentaria corre en la playa" {

		const correrEnLaPlaya = new Running(intensidad = 1.2)
		const calamardo = new Persona_sedentaria(tiempo = 5,peso = 60)
		
		calamardo.realizarRutina(correrEnLaPlaya)
		assert.equals(59.948,calamardo.peso())
	}


	test "calamardo persona sedentaria rema en el delta"
	{

		const calamardo = new Persona_sedentaria(tiempo = 5,peso = 60)
		const remarEnElDelta = new Remo()

		calamardo.realizarRutina(remarEnElDelta)
		assert.equals(59.925,calamardo.peso())
		
	}

	
	test "calamardo persona sedentaria rema en camino remeros"
	{

		const remarEnCaminoRemeros = new Remo_Competicion()
		const calamardo = new Persona_sedentaria(tiempo = 5,peso = 60)
		
		
		calamardo.realizarRutina(remarEnCaminoRemeros)
		assert.equals(59.927,calamardo.peso())
		
	}
		

	test "calamardo realiza rutina de maraton BA"
	{

		const calamardo = new Persona_sedentaria(tiempo = 5,peso = 60)
		const maratonBA = new Maraton(intensidad = 1.5)

		calamardo.realizarRutina(maratonBA)
		assert.equals(59.871,calamardo.peso())
		
	}

	test "test sedentario no puede practicar, hacer que calamardo practique correrEnLaPlaya (NO SE PUEDE!) el peso de calamardo debería ser 40 "
	{

		const calamardo = new Persona_sedentaria(tiempo = 5,peso = 40)
		const maratonBA = new Maraton(intensidad = 1.5)

		
		assert.throwsException({calamardo.realizarRutina(maratonBA)})		
	}



	//prueba como persona atleta

	test "bob realiza rutina de persona atleta maraton BA"
	{

		const bob = new Persona_atleta(peso = 40)
		const maratonBA = new Maraton(intensidad = 1.5)

		bob.realizarRutina(maratonBA)
		assert.equals(37.812,bob.peso())
	}	


	test "bob realiza rutina de persona atleta correr en la playa"
	{

		const bob = new Persona_atleta(peso = 40)
		const correrEnLaPlaya = new Running(intensidad = 1.2)

		bob.realizarRutina(correrEnLaPlaya)
		assert.equals(39.725,bob.peso())

	}	

	
	test "bob realiza rutina de persona atleta Remar en el delta
		  No se puede porque las calorías de esta rutina es menor a 10000, 
		  el peso se mantiene en 40"
	{

		const bob = new Persona_atleta(peso = 40)
		const remarEnElDelta = new Remo()

		assert.throwsException({bob.realizarRutina(remarEnElDelta)})
	}	
	
	test "bob realiza rutina del camino de los remeros"
	{

		const remarEnCaminoRemeros = new Remo_Competicion()
		const bob = new Persona_atleta(peso = 40)
		
		bob.realizarRutina(remarEnCaminoRemeros)
		assert.equals(39.406,bob.peso())

	}	

	test "PUNTO TRES CLUBES
	      El mejor predio del clubBarrial para 
		  bob debería ser recreo" {
	  
		//un predio con correrEnLaPlaya y maratonBA
		const correrEnLaPlaya = new Running(intensidad = 1.2)
		const maratonBA = new Maraton(intensidad = 1.5)
		const remarEnCaminoRemeros = new Remo_Competicion()
		const remarEnElDelta = new Remo()

		const recreo = new Predio(rutinas = #{correrEnLaPlaya, maratonBA}) 
		const nautico = new Predio(rutinas = #{remarEnCaminoRemeros,remarEnElDelta}) 

		const clubBarrial = new Club(predios = #{recreo, nautico})

		const bob = new Persona_atleta(peso = 40)

		assert.equals(recreo,clubBarrial.mejorPredioParaPersona(bob))
		assert.equals(35700,recreo.totalCaloriasQuemadasEnRutinasPor(bob))

	}

	
	test "El mejor predio del clubBarrial para calamardo debería ser nautico" {

		const correrEnLaPlaya = new Running(intensidad = 1.2)
		const maratonBA = new Maraton(intensidad = 1.5)
		const remarEnCaminoRemeros = new Remo_Competicion()
		const remarEnElDelta = new Remo()

		const recreo = new Predio(rutinas = #{correrEnLaPlaya, maratonBA}) 
		const nautico = new Predio(rutinas = #{remarEnCaminoRemeros,remarEnElDelta}) 

		const clubBarrial = new Club(predios = #{recreo, nautico})

		const calamardo = new Persona_sedentaria(tiempo = 5,peso = 60)	

		assert.equals(recreo,clubBarrial.mejorPredioParaPersona(calamardo))
		assert.equals(1260,recreo.totalCaloriasQuemadasEnRutinasPor(calamardo))

	}	


	test "No debería haber predios tranquis en el clubBarrial para bob" {

		const correrEnLaPlaya = new Running(intensidad = 1.2)
		const maratonBA = new Maraton(intensidad = 1.5)
		const remarEnCaminoRemeros = new Remo_Competicion()
		const remarEnElDelta = new Remo()

		const recreo = new Predio(rutinas = #{correrEnLaPlaya, maratonBA}) 
		const nautico = new Predio(rutinas = #{remarEnCaminoRemeros,remarEnElDelta}) 

		const clubBarrial = new Club(predios = #{recreo, nautico})

		const bob = new Persona_atleta(peso = 40)

		assert.equals(#{},clubBarrial.prediosTranquisDeUnClubPara(bob))
	
	}	


	test "Para calamardo, el conjunto de predios tranquis solo tiene a el recreo, ya que ahí puede correr por la playa gastando solo 360 calorías" {
	  
	
		const correrEnLaPlaya = new Running(intensidad = 1.2)
		const maratonBA = new Maraton(intensidad = 1.5)
		const remarEnCaminoRemeros = new Remo_Competicion()
		const remarEnElDelta = new Remo()

		const recreo = new Predio(rutinas = #{correrEnLaPlaya, maratonBA}) 
		const nautico = new Predio(rutinas = #{remarEnCaminoRemeros,remarEnElDelta}) 

		const clubBarrial = new Club(predios = #{recreo, nautico})

		const calamardo = new Persona_sedentaria(tiempo = 5,peso = 40)	
	
		assert.equals(#{recreo},clubBarrial.prediosTranquisDeUnClubPara(calamardo))
	
	}


	test "para bob las rutinas más exigentes del club barrial son la maratón de buenos aires y remar en el camino de los remeros." {

		const correrEnLaPlaya = new Running(intensidad = 1.2)
		const maratonBA = new Maraton(intensidad = 1.5)
		const remarEnCaminoRemeros = new Remo_Competicion()
		const remarEnElDelta = new Remo()

		const recreo = new Predio(rutinas = #{correrEnLaPlaya, maratonBA}) 
		const nautico = new Predio(rutinas = #{remarEnCaminoRemeros,remarEnElDelta}) 

		const clubBarrial = new Club(predios = #{recreo, nautico})

		const bob = new Persona_atleta(peso = 40)


		assert.equals([maratonBA,remarEnCaminoRemeros],clubBarrial.rutinaMasExigentePara(bob))
	
	}


	test "para calamardo las rutinas más exigentes del club barrial son la 	maratón de buenos aires y remar en el delta" {
	  
		const correrEnLaPlaya = new Running(intensidad = 1.2)
		const maratonBA = new Maraton(intensidad = 1.5)
		const recreo = new Predio(rutinas = #{correrEnLaPlaya, maratonBA}) 
		
		
		const remarEnCaminoRemeros = new Remo_Competicion()
		const remarEnElDelta = new Remo()
		const nautico = new Predio(rutinas = #{remarEnCaminoRemeros,remarEnElDelta}) 


		const clubBarrial = new Club(predios = #{recreo, nautico})

		const calamardo = new Persona_sedentaria(tiempo = 5,peso = 60)	
	
		assert.equals([maratonBA,remarEnElDelta],clubBarrial.rutinaMasExigentePara(calamardo))
	
	}



}